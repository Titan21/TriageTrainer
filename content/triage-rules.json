{
  "version": 1,
  "approved": false,
  "notice": "Practice values only. These triage steps and thresholds are common published ones (UK triage sieve and START for adults, JumpSTART for children), not NZRT's protocol. Check with your team before relying on them.",
  "categories": [
    { "id": "red", "label": "Immediate", "priority": 1, "colour": "#c62828" },
    { "id": "orange", "label": "Urgent", "priority": 2, "colour": "#ef6c00" },
    { "id": "green", "label": "Delayed / walking", "priority": 3, "colour": "#2e7d32" },
    { "id": "black", "label": "Dead", "priority": 4, "colour": "#111111" }
  ],
  "scoring": {
    "notes": "Points off a score of 100. Tag penalties by correct category (row) and assigned category (column): under-triage costs more than over-triage, and tagging a salvageable casualty black is the worst outcome. An untagged casualty costs its row's maximum. Safety actions are never penalised; missing an expected one is.",
    "triagePenalty": {
      "red": { "red": 0, "orange": 18, "green": 30, "black": 45 },
      "orange": { "red": 6, "orange": 0, "green": 18, "black": 45 },
      "green": { "red": 9, "orange": 3, "green": 0, "black": 45 },
      "black": { "red": 9, "orange": 9, "green": 9, "black": 0 }
    },
    "missedLifeSavingIntervention": 20,
    "enteredOrStayedInDanger": 15,
    "targetSecondsPerCasualty": 60,
    "overtimePenaltyPer10Seconds": 1,
    "skippedCheck": 2,
    "missedKeyAction": 3,
    "wrongAction": 1,
    "sillyAction": 2,
    "missedRetriage": 3,
    "otherEventMissed": 3,
    "missedSafetyAction": 5,
    "skippedDangerCheck": 2,
    "rescuerInjured": 10,
    "qteWrong": 15,
    "qteSlow": 3
  },
  "sieves": {
    "adult": {
      "steps": [
        {
          "id": "catastrophic_bleed",
          "question": "Catastrophic bleeding?",
          "when": {
            "all": [
              { "field": "catastrophicBleed", "op": "eq", "value": true },
              {
                "not": {
                  "all": [
                    { "field": "breathing", "op": "eq", "value": false },
                    { "field": "breathesAfterAirwayOpen", "op": "eq", "value": false }
                  ]
                }
              }
            ]
          },
          "category": "red",
          "checks": [],
          "note": "Control it first (tourniquet, packing, pressure), then tag red. Does not apply to someone who is not breathing even with the airway opened; they fall through to black."
        },
        {
          "id": "walking",
          "question": "Can they walk?",
          "when": { "field": "canWalk", "op": "eq", "value": true },
          "category": "green",
          "checks": [["ask_to_walk", "call_walking_wounded"]],
          "ruleOutChecks": []
        },
        {
          "id": "not_breathing_after_airway",
          "question": "Not breathing even after the airway is opened?",
          "when": {
            "all": [
              { "field": "breathing", "op": "eq", "value": false },
              { "field": "breathesAfterAirwayOpen", "op": "eq", "value": false }
            ]
          },
          "category": "black",
          "checks": ["check_breathing", "open_airway"],
          "ruleOutChecks": ["check_breathing"]
        },
        {
          "id": "breathing_after_airway",
          "question": "Breathing only after the airway is opened?",
          "when": {
            "all": [
              { "field": "breathing", "op": "eq", "value": false },
              { "field": "breathesAfterAirwayOpen", "op": "eq", "value": true }
            ]
          },
          "category": "red",
          "checks": ["check_breathing", "open_airway"],
          "ruleOutChecks": ["check_breathing"],
          "note": "Keep the airway open (recovery position) and tag red."
        },
        {
          "id": "respiratory_rate",
          "question": "Breathing rate under {{adult.rrLow}} or over {{adult.rrHigh}}?",
          "when": {
            "any": [
              { "field": "rr", "op": "lt", "threshold": "adult.rrLow" },
              { "field": "rr", "op": "gt", "threshold": "adult.rrHigh" }
            ]
          },
          "category": "red",
          "checks": ["check_breathing"]
        },
        {
          "id": "circulation",
          "question": "No radial pulse, or capillary refill over {{adult.crtMax}} seconds?",
          "when": {
            "any": [
              { "field": "radialPulse.present", "op": "eq", "value": false },
              { "field": "crtSeconds", "op": "gt", "threshold": "adult.crtMax" }
            ]
          },
          "category": "red",
          "checks": [["check_radial_pulse", "check_crt"]]
        },
        {
          "id": "commands",
          "question": "Unable to follow simple commands?",
          "when": { "field": "obeysCommands", "op": "eq", "value": false },
          "category": "red",
          "checks": ["give_command"]
        },
        {
          "id": "otherwise",
          "question": "None of the above",
          "when": true,
          "category": "orange",
          "checks": []
        }
      ]
    },
    "child": {
      "steps": [
        {
          "id": "catastrophic_bleed",
          "question": "Catastrophic bleeding?",
          "when": {
            "all": [
              { "field": "catastrophicBleed", "op": "eq", "value": true },
              {
                "not": {
                  "all": [
                    { "field": "breathing", "op": "eq", "value": false },
                    { "field": "breathesAfterAirwayOpen", "op": "eq", "value": false },
                    { "not": { "field": "breathesAfterRescueBreaths", "op": "eq", "value": true } }
                  ]
                }
              }
            ]
          },
          "category": "red",
          "checks": []
        },
        {
          "id": "walking",
          "question": "Can they walk?",
          "when": { "field": "canWalk", "op": "eq", "value": true },
          "category": "green",
          "checks": [["ask_to_walk", "call_walking_wounded"]],
          "ruleOutChecks": []
        },
        {
          "id": "breathing_after_airway",
          "question": "Breathing only after the airway is opened?",
          "when": {
            "all": [
              { "field": "breathing", "op": "eq", "value": false },
              { "field": "breathesAfterAirwayOpen", "op": "eq", "value": true }
            ]
          },
          "category": "red",
          "checks": ["check_breathing", "open_airway"],
          "ruleOutChecks": ["check_breathing"]
        },
        {
          "id": "no_pulse_no_breathing",
          "question": "Still not breathing and no pulse?",
          "when": {
            "all": [
              { "field": "breathing", "op": "eq", "value": false },
              { "field": "breathesAfterAirwayOpen", "op": "eq", "value": false },
              { "field": "radialPulse.present", "op": "eq", "value": false }
            ]
          },
          "category": "black",
          "checks": ["check_breathing", "open_airway", "check_radial_pulse"],
          "ruleOutChecks": ["check_breathing"]
        },
        {
          "id": "breathing_after_rescue_breaths",
          "question": "Has a pulse and breathes after 5 rescue breaths?",
          "when": {
            "all": [
              { "field": "breathing", "op": "eq", "value": false },
              { "field": "breathesAfterAirwayOpen", "op": "eq", "value": false },
              { "field": "breathesAfterRescueBreaths", "op": "eq", "value": true }
            ]
          },
          "category": "red",
          "checks": ["check_breathing", "open_airway", "check_radial_pulse", "rescue_breaths"],
          "ruleOutChecks": ["check_breathing"]
        },
        {
          "id": "not_breathing_after_rescue_breaths",
          "question": "Has a pulse but still not breathing after rescue breaths?",
          "when": {
            "all": [
              { "field": "breathing", "op": "eq", "value": false },
              { "field": "breathesAfterAirwayOpen", "op": "eq", "value": false }
            ]
          },
          "category": "black",
          "checks": ["check_breathing", "open_airway", "check_radial_pulse", "rescue_breaths"],
          "ruleOutChecks": ["check_breathing"]
        },
        {
          "id": "respiratory_rate",
          "question": "Breathing rate under {{child.rrLow}} or over {{child.rrHigh}}?",
          "when": {
            "any": [
              { "field": "rr", "op": "lt", "threshold": "child.rrLow" },
              { "field": "rr", "op": "gt", "threshold": "child.rrHigh" }
            ]
          },
          "category": "red",
          "checks": ["check_breathing"]
        },
        {
          "id": "circulation",
          "question": "No palpable radial pulse?",
          "when": { "field": "radialPulse.present", "op": "eq", "value": false },
          "category": "red",
          "checks": ["check_radial_pulse"]
        },
        {
          "id": "responsiveness",
          "question": "Unresponsive, or responds to pain inappropriately?",
          "when": {
            "any": [
              { "field": "responsive", "op": "eq", "value": "unresponsive" },
              {
                "all": [
                  { "field": "responsive", "op": "eq", "value": "pain" },
                  { "field": "painResponseAppropriate", "op": "eq", "value": false }
                ]
              }
            ]
          },
          "category": "red",
          "checks": ["check_response"]
        },
        {
          "id": "otherwise",
          "question": "None of the above",
          "when": true,
          "category": "orange",
          "checks": []
        }
      ]
    }
  },
  "thresholds": {
    "notes": "Numbers the sieves use. Conditions refer to them with \"threshold\" instead of \"value\", and any content text can quote them as {{adult.rrHigh}}, so changing a number here changes the rules and every text that mentions it.",
    "adult": { "rrLow": 10, "rrHigh": 30, "crtMax": 2 },
    "child": { "rrLow": 15, "rrHigh": 45 }
  }
}
